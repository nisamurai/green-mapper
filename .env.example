# backend auth
BETTER_AUTH_SECRET=<secret>
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_DISABLE_LOGGER=false
CORS_ORIGIN="http://loclahost,http://localhost:5173"
DEVELOPMENT=true

# backend sso
YANDEX_CLIENT_ID=<id>
YANDEX_CLIENT_SECRET=<secret>

SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=<user>
SMTP_PASS=<password>
SMTP_FROM=<email>

# s3
MINIO_ROOT_USER=<user>
MINIO_ROOT_PASSWORD=<password>
MINIO_MAIN_BUCKET="qwipfm-oqcim-bsr" # при желании перед первым развертыванием можно поставить что-то осмысленное, но после не менять, загруженные фотки не переедут

# Redis
REDIS_PASSWORD=<password>

# RabbitMQ
RABBITMQ_USER=<user>
RABBITMQ_PASSWORD=<password>
RABBITMQ_DELAY_SECONDS=4.5 #лучше брать 2-3 секунды, но если в логах нет подключения - посмотреть в логах rabbitmq сколько он запускается, там пишется, и поставить чуть больше

# postgres
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<database>

# Ollama
OLLAMA_HOST=<host>
OLLAMA_MODEL=<model>
SKIP_LLM=true # !!! поставить false чтобы работала модель


# frontend
VITE_BETTER_AUTH_BASE_URL=/api/auth # не трогать!!!!!!
VITE_API_BASE_URL=/api # не трогать!!!!!!
VITE_MINIO_BASE_URL=http://localhost:9000
CADDY_PROXY_URL=http://localhost:3000