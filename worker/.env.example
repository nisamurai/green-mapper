# backend auth
BETTER_AUTH_SECRET=<secret>

# s3
MINIO_ROOT_USER=<user>
MINIO_ROOT_PASSWORD=<password>
MINIO_MAIN_BUCKET="qwipfm-oqcim-bsr"

# RabbitMQ
RABBITMQ_USER=<user>
RABBITMQ_PASSWORD=<password>
RABBITMQ_DELAY_SECONDS=4.5 #лучше брать 2-3 секунды, но если в логан нет подключения - посмотреть в логах rabbitmq сколько он запускается, там пишется

# Ollama
OLLAMA_HOST=<host>
OLLAMA_MODEL=<model>
SKIP_LLM=false